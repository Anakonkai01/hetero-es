{
  "name": "@heteroes/worker",
  "version": "0.1.0",
  "private": true,
  "description": "HeteroES native GPU worker",
  "author": "HeteroES Lab",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "pack:windows": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@heteroes/product-ui": "0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tar": "^7.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "org.heteroes.worker",
    "productName": "HeteroES Worker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "worker"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "executableName": "heteroes-worker",
      "icon": "resources/icon.png",
      "desktop": {
        "entry": {
          "Name": "HeteroES Worker"
        }
      },
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "allowElevation": false
    },
    "publish": null,
    "electronVersion": "41.10.7"
  },
  "desktopName": "heteroes-worker.desktop"
}
