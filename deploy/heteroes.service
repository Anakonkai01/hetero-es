[Unit]
Description=HeteroES CPU control plane
After=network-online.target
Wants=network-online.target

[Service]
User=heteroes
Group=heteroes
WorkingDirectory=/opt/heteroes
Environment=HETEROES_PRIVATE_CONFIG=/etc/heteroes
ExecStart=/opt/heteroes/.venv/bin/uvicorn backend.app:app_from_environment --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/heteroes

[Install]
WantedBy=multi-user.target
