# systemd USER unit for the owner's workstation layout: starts the lab (Web/API, public entry and the
# Cloudflare tunnel) after a boot or login and stops it gracefully. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/heteroes-lab.user.service ~/.config/systemd/user/heteroes-lab.service
#   systemctl --user daemon-reload && systemctl --user enable --now heteroes-lab
# To start before anyone logs in (once): sudo loginctl enable-linger $USER
# `boot` starts what is not running, never launches a job, and leaves the queue held if a run or a GPU
# reservation was live when the machine went down. Adjust the two paths for another layout.
# The script needs fastapi, so it runs with the lab venv Python, not /usr/bin/python3 (which fails and restarts forever).
# The lab runs from a deployed clone of the branch `main` (never from the working tree, so a reboot in the middle
# of unfinished work cannot load it). Deploy or update it from the repository root:
#   git clone --branch main ~/projects/heteroes ~/.local/share/heteroes-lab/app        (first time)
#   git -C ~/.local/share/heteroes-lab/app pull --ff-only                             (update, then local-lab.py restart)
# and build its web UI with `npm run build --workspace frontend -- --outDir ~/.local/share/heteroes-lab/app/frontend/dist`.
[Unit]
Description=HeteroES lab: Web/API, public entry and Cloudflare tunnel
After=network-online.target
Wants=network-online.target
# Keep trying: a start that fails (for example while the storage disk is not mounted yet) is repeated every 30 s.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=%h/.local/share/heteroes-lab/venv-backend/bin/python -I %h/.local/share/heteroes-lab/app/scripts/local-lab.py boot --python %h/.local/share/heteroes-lab/venv-backend/bin/python
ExecStop=-%h/.local/share/heteroes-lab/venv-backend/bin/python -I %h/.local/share/heteroes-lab/app/scripts/local-lab.py stop --python %h/.local/share/heteroes-lab/venv-backend/bin/python
Restart=on-failure
RestartSec=30
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=default.target
