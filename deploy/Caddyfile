{$HETEROES_DOMAIN} {
    request_body {
        max_size 3MB
    }
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        root * /opt/heteroes/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
