+// ---- Persistent decode schedule (same items, sums, partial planes and encodings as integer_stream_group) ----
+// Item = column tile * SPLIT_K + split, over the column tiles of up to three matrices in order; a single row
+// tile (rows <= MT). CTA c owns items c, c + gridDim.x, ...; one cp.async pipeline runs across its items, so a
+// CTA fills the pipeline once instead of once per item. Each item accumulates exactly the K range and writes
+// exactly the partial plane (or encoded output) of the non-persistent launch, whatever the CTA count.
+struct PersistItem { int g, column0, z, begin, count; };
+__device__ __forceinline__ PersistItem persist_item(int item, int t0, int t1) {
+  const int tiles=(WIDTH+KS-1)/KS, per=(tiles+SPLIT_K-1)/SPLIT_K;
+  PersistItem p;
+  const int tile=item/SPLIT_K;  // a compile-time divisor
+  p.z=item-tile*SPLIT_K;
+  p.g=tile<t0 ? 0 : tile<t0+t1 ? 1 : 2;
+  p.column0=(tile-(p.g>0 ? t0 : 0)-(p.g>1 ? t1 : 0))*NT;
+  p.begin=p.z*per;
+  const int end=min(tiles,p.begin+per);
+  p.count=end>p.begin ? end-p.begin : 0;
+  return p;
+}
+extern "C" __global__ void __launch_bounds__(128)
+integer_persist(const qi_t* x,const int* ex,int* error,i64* partials,
+                const u16* w0,const u16* w1,const u16* w2,const u16* b0,const u16* b1,const u16* b2,
+                const int* e0,const int* e1,const int* e2,float* o0,float* o1,float* o2,
+                unsigned* zeroed,int rows,int n0,int n1,int n2,int zero_count) {
+  // A fused consumer accumulates per-row maxima into `zeroed` after this grid; clear it here (one CTA).
+  if(zero_count && !blockIdx.x)
