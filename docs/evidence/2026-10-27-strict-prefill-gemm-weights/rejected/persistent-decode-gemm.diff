+          if(row<rows && n<outputs) {
+            i64 sum=0;
+            #pragma unroll
+            for(int degree=0;degree<2*DIGITS-1;++degree) sum+=(i64)accum[m][j][degree][d]*(1ll<<(8*degree));
+#if SPLIT_K > 1
+            partials[((size_t)ci.z*rows+row)*columns+offset+n]=sum;
+#else
