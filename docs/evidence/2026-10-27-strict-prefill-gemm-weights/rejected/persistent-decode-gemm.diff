+    for(int i=threadIdx.x;i<zero_count;i+=128) zeroed[i]=0u;
+  __shared__ __align__(16) unsigned char weights_shared[STAGES][W_STAGE];
+  __shared__ __align__(16) unsigned char inputs_shared[STAGES][A_STAGE];
+  const int lane=threadIdx.x&31, warp=threadIdx.x>>5, group=lane>>2, thread=lane&3;
+  const int t0=(n0+NT-1)/NT, t1=(n1+NT-1)/NT, t2=(n2+NT-1)/NT, items=(t0+t1+t2)*SPLIT_K;
+  const int stride=gridDim.x, columns=n0+n1+n2;
+  // Producer: the next K tile to stage, walking this CTA's items in order (items without K tiles skipped).
+  // No trip count is precomputed: a runtime-stride count divides (MUFU.RCP, rejected by the audit).
+  int p_item=blockIdx.x, p_k=0;
+  PersistItem pi=persist_item(p_item,t0,t1);
+  auto produce=[&](int slot) {
+    #pragma unroll 1
+    while(p_item<items && pi.count<=p_k) {p_item+=stride; p_k=0; pi=persist_item(p_item,t0,t1);}
+    if(p_item>=items) return;
+    stream_stage(weights_shared[slot],inputs_shared[slot],x,GROUP_SELECT(pi.g,w0,w1,w2),rows,
+                 GROUP_SELECT(pi.g,n0,n1,n2),0,pi.column0,(pi.begin+p_k)*KS);
+    ++p_k;
