+    const int* ew=GROUP_SELECT(ci.g,e0,e1,e2);
+    const u16* bias=GROUP_SELECT(ci.g,b0,b1,b2);
+    float* out=GROUP_SELECT(ci.g,o0,o1,o2);
+    #pragma unroll
+    for(int m=0;m<M_GROUPS;++m) {
