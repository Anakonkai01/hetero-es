+  unsigned scale[2];
+#else
+  int scale[2];
+#endif
+  auto load_scale=[&]() {
+    #pragma unroll
+    for(int j=0;j<JN;++j) {
+      exponent[j]=upcoming[j];
+#if FAST_CONVERT
+      scale[j]=(unsigned)((MAGNITUDE_BITS-1-exponent[j])*0x800000);
+#else
+      scale[j]=exponent[j];
+#endif
+    }
+    fetch_exponents(upcoming,c_item+stride);
+  };
