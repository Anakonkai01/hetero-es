[
  {
    "name": "shared rather than exclusive writer lock",
    "file": "backend/writer_lock.py",
    "old": "fcntl.LOCK_EX | fcntl.LOCK_NB",
    "new": "fcntl.LOCK_SH | fcntl.LOCK_NB"
  },
  {
    "name": "lock config folder rather than actual database",
    "file": "backend/app.py",
    "old": "writer=acquire_writer(Path(config['productStateDirectory'])/'product.sqlite')",
    "new": "writer=acquire_writer(root/'state/product.sqlite')"
  },
  {
    "name": "release while dispatcher thread can still write",
    "file": "backend/app.py",
    "old": "await run_in_threadpool(thread.join)",
    "new": "await run_in_threadpool(thread.join, timeout=2)"
  },
  {
    "name": "keep lock after completed shutdown",
    "file": "backend/app.py",
    "old": "if writer_lock is not None:writer_lock.close()",
    "new": "if False:writer_lock.close()"
  }
]
