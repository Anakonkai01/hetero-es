@@ -0,0 +1,107 @@
+"""Product state facade. Runtime ledgers remain owned by device agents."""
+
+from contextlib import contextmanager
+import os
+from pathlib import Path
+import threading
+
+from argon2 import PasswordHasher
+
+from .accounts import AccountService
+from .device_state import DeviceStateService
+from .scheduling import SchedulingService
+from .experiment_state import ExperimentStateService
+from .workspaces import WorkspaceStateService
+from ..core.clock import now as now
+from ..db.database import SQLiteDatabase
+from .audit import AuditService
+from ..core.constants import ACTIVE as ACTIVE, TERMINAL as TERMINAL
+
+
+class Store:
+    def __init__(self, path, passwords, runtime):
+        self.path, self.runtime = str(path), runtime
+        Path(path).parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+        self.lock = threading.RLock()
+        self.operation_lock = threading.RLock()
+        self.hasher = PasswordHasher()
+        self.accounts = AccountService(self)
+        self.audit_service = AuditService()
+        self.device_state = DeviceStateService(self)
+        self.scheduling = SchedulingService(self)
+        self.experiments = ExperimentStateService(self)
+        self.workspace_state = WorkspaceStateService(self)
+        self.last_error = None
+        self.database = SQLiteDatabase(self.path, self.lock)
+        self.database.initialize(passwords, self.hasher)
+        os.chmod(path, 0o600)
+        runtime.attach_store(self)
+        try:
+            self.ensure_workers(runtime.capabilities()["workerIds"])
+        except Exception:
+            self.last_error = "WorkerConfigurationUnavailable"
+
+    @contextmanager
+    def db(self):
+        with self.database.connection() as connection:
+            yield connection
+
+    def audit(self, db, actor, action, target, workspace_id=None):
+        return self.audit_service.audit(db=db, actor=actor, action=action, target=target, workspace_id=workspace_id)
+
+    def ensure_workers(self, ids):
+        return self.device_state.ensure_workers(ids=ids)
+
+    def profile(self, user_id):
+        return self.accounts.profile(user_id)
+
+    def workspaces(self, user_id):
+        return self.workspace_state.workspaces(user_id=user_id)
+
+    def assignments(self, workspace_id, include_disabled=False):
+        return self.device_state.assignments(workspace_id=workspace_id, include_disabled=include_disabled)
+
+    def disabled_workers(self, db):
+        return self.device_state.disabled_workers(db=db)
+
+    def cancel_selected(self, db, worker_id, *, include_queued=True, keep=()):
+        return self.experiments.cancel_selected(db=db, worker_id=worker_id, include_queued=include_queued, keep=keep)
+
+    def cancel_owned(self, db, owner, workspace_id=None):
+        return self.experiments.cancel_owned(db=db, owner=owner, workspace_id=workspace_id)
+
+    def eligibility(self, db, body, workers=None):
+        return self.experiments.eligibility(db=db, body=body, workers=workers)
+
+    def get(self, run_id):
+        return self.experiments.get(run_id=run_id)
+
+    def list(self):
+        return self.experiments.list()
+
+    def save(self, db, body):
+        return self.experiments.save(db=db, body=body)
+
+    def create(self, owner, config, workspace_id="lab"):
+        return self.experiments.create(owner=owner, config=config, workspace_id=workspace_id)
+
+    def device_names(self):
+        return self.device_state.device_names()
+
+    def device_identities(self):
+        return self.device_state.device_identities()
+
+    def snapshot(self, run_id):
+        return self.experiments.snapshot(run_id=run_id)
+
+    def dispatch_once(self):
+        return self.scheduling.dispatch_once()
+
+    def _dispatch_once(self):
+        return self.scheduling._dispatch_once()
+
+    def _dispatch_run(self, active):
+        return self.scheduling._dispatch_run(active=active)
+
+    def dispatch(self, stop):
+        return self.scheduling.dispatch(stop=stop)  # errors never become fabricated success/rewards
diff --git a/backend/services/timeline.py b/backend/services/timeline.py
new file mode 100644
index 00000000..b9ff3129
--- /dev/null
+++ b/backend/services/timeline.py
@@ -0,0 +1,230 @@
+"""A compact, time-ordered view of one run for the Live, Timeline and Replay screens.
+
+Pure: it reads the stored snapshot and returns plain data, so a finished run and a running one are described the
+same way. Times are epoch milliseconds; generations are numbered from 0 as in the ledger.
+"""
+
+from datetime import datetime
+import math
+import time
+
+# Moments worth showing on a timeline. Routine chatter (a worker asking for work) is deliberately not a mark.
+MARKS = frozenset(
+    {
+        "replay",
+        "worker_unavailable",
+        "worker_start_unknown",
+        "worker_start",
+        "model_loaded",
+        "executor_ready",
+        "transport_error",
+        "coordinator_recovery",
+        "recovered",
+        "generation_resumed",
+        "recovery_point_error",
+        "managed_error",
+        "audit_mismatch",
+        "audit_worker_quarantined",
+        "audit_incomplete",
+        "membership_changed",
+        "membership_refused",
+        "worker_joined",
+        "worker_left",
+        "worker_restarted",
+        "worker_unreachable",
+        "worker_reachable",
+        "worker_lost",
+        "worker_blocked",
+        "worker_retry_requested",
+    }
+)
+SECONDS = (
+    ("wait", "wait_seconds"),
+    ("update", "update_seconds"),
+    ("publish", "publish_seconds"),
+    ("record", "record_seconds"),
+    ("total", "total_seconds"),
+)
+
+
+def _number(value):
+    return value if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) else None
+
+
+def _ms_from_iso(value):
+    try:
+        return int(datetime.fromisoformat(value).timestamp() * 1000)
+    except (TypeError, ValueError):
+        return None
+
+
+def _ms_from_epoch(value):
+    number = _number(value)
+    return None if number is None else int(number * 1000)
+
+
+def _generation_index(generation_id):
+    try:
+        return int(str(generation_id).rsplit(".g", 1)[1])
+    except (IndexError, ValueError):
+        return None
+
+
+def build_timeline(body, snapshot, now_ms=None, names=None):
+    names = names or {}
+    snapshot = snapshot or {}
+    state = snapshot.get("state") or {}
+    recorded = (body or {}).get("workerIdentities", {})
+
+    def identity(worker_id):
+        value = recorded.get(worker_id) or names.get(worker_id)
+        if isinstance(value, str):
+            return {"name": value, "identitySource": "current"}
+        if isinstance(value, dict):
+            return {
+                "name": value.get("name"),
+                "gpuName": value.get("gpuName"),
+                "gpuUUID": value.get("gpuUUID"),
+                "gpuIndex": value.get("gpuIndex"),
+                "identitySource": value.get("source", "current"),
+            }
+        return {"name": None, "identitySource": "unknown"}
+
+    events = sorted(
+        (e for e in snapshot.get("events") or [] if isinstance(e, dict) and _number(e.get("t")) is not None),
+        key=lambda e: e["t"],
+    )
+    candidates = {c.get("candidateId"): c for c in snapshot.get("candidates") or []}
+
+    jobs = []
+    for item in snapshot.get("attempts") or []:
+        start = _ms_from_iso(item.get("startedAt"))
+        if start is None:
+            continue
+        candidate = candidates.get(item.get("candidateId"), {})
+        won = (
+            candidate.get("status") == "COMMITTED"
+            and candidate.get("attemptId") == item.get("attemptId")
+            and item.get("status") == "SUCCEEDED"
+        )
+        jobs.append(
+            {
+                "candidateId": item.get("candidateId"),
+                "attemptId": item.get("attemptId"),
+                "generation": _generation_index(item.get("generationId")),
+                "workerId": item.get("workerId"),
+                "seed": candidate.get("seed"),
+                "startMs": start,
+                "endMs": _ms_from_iso(item.get("completedAt")),
+                "status": item.get("status"),
+                "reward": _number(candidate.get("reward")) if won else None,
+            }
+        )
+    jobs.sort(key=lambda j: (j["startMs"], j["candidateId"] or ""))
+
+    by_generation = {}
+    for event in events:
+        index = event.get("generation")
+        if isinstance(index, int) and event.get("event") in (
+            "generation_open",
+            "generation_complete",
+            "generation_done",
+        ):
+            by_generation.setdefault(index, {})[event["event"]] = event
+    generations = []
+    for item in snapshot.get("generations") or []:
+        index = _generation_index(item.get("generationId"))
+        if index is None:
+            continue
+        seen = by_generation.get(index, {})
+        done = seen.get("generation_done", {})
+        finished = item.get("status") == "COMPLETED"
+        seconds = {name: _number(done.get(key)) for name, key in SECONDS if _number(done.get(key)) is not None}
+        generations.append(
+            {
+                "index": index,
+                "id": item.get("generationId"),
+                "status": item.get("status"),
+                "openMs": _ms_from_epoch(seen.get("generation_open", {}).get("t"))
+                or _ms_from_iso(item.get("startedAt")),
+                "evaluatedMs": _ms_from_epoch(seen.get("generation_complete", {}).get("t")),
+                "doneMs": _ms_from_epoch(done.get("t"))
+                or (_ms_from_iso(item.get("completedAt")) if finished else None),
+                "candidateCount": item.get("candidateCount"),
+                "committedCount": item.get("committedCandidateCount"),
+                "rewardMean": _number(item.get("rewardMean", done.get("mean_reward"))),
+                "rewardBest": _number(item.get("rewardBest", done.get("max_reward"))),
+                "seconds": seconds,
+            }
+        )
+    generations.sort(key=lambda g: g["index"])
+
+    workers, known = [], set()
+    for worker_id, info in (state.get("workerStates") or {}).items():
+        known.add(worker_id)
+        info = info or {}
+        # not answering now (finding 11): its last known alive/ready says nothing about the present
+        away = None if info.get("confirmed", True) else _ms_from_epoch(info.get("unreachableSince"))
+        workers.append(
+            {
+                "id": worker_id,
+                **identity(worker_id),
+                "started": not info.get("notStarted", False),
+                "alive": info.get("alive"),
+                "unreachableSinceMs": away,
+                "stopReason": info.get("stopReason"),
+                "blockedAtMs": _ms_from_epoch(info.get("blockedAt")),
+            }
+        )
+    for job in jobs:
+        if job["workerId"] and job["workerId"] not in known:
+            known.add(job["workerId"])
+            workers.append({"id": job["workerId"], **identity(job["workerId"]), "started": True, "alive": None})
+    for worker_id in (body or {}).get("workerIds", []):
+        if worker_id not in known:
+            known.add(worker_id)
+            workers.append({"id": worker_id, **identity(worker_id), "started": False, "alive": None})
+
+    marks = []
+    for event in events:
+        if event.get("event") in MARKS:
+            mark = {
+                "atMs": int(event["t"] * 1000),
+                "type": event["event"],
+                "workerId": event.get("worker_id"),
+                "generation": event.get("generation"),
+            }
+            if isinstance(event.get("error"), str):
+                mark["detail"] = event["error"][:200]
+            elif isinstance(event.get("reason"), str):
+                mark["detail"] = event["reason"][:200]
+            marks.append(mark)
+
+    body = body or {}
+    started = _ms_from_epoch(state.get("startedAt")) or _ms_from_iso(body.get("startedAt"))
+    completed = _ms_from_epoch(state.get("completedAt")) or _ms_from_iso(body.get("completedAt"))
+    detailed = sorted({job["generation"] for job in jobs if job["generation"] is not None})
+    expected = sum(item.get("candidateCount") or 0 for item in generations)
+    return {
+        "experiment": {
+            "id": body.get("experimentId"),
+            "name": body.get("name"),
+            "status": state.get("status") or body.get("status"),
+            "createdMs": _ms_from_iso(body.get("createdAt")),
+            "startedMs": started,
+            "completedMs": completed,
+            "maxGenerations": body.get("maxGenerations"),
+            "candidatesPerGeneration": body.get("candidatesPerGeneration"),
+        },
+        "workers": workers,
+        "generations": generations,
+        "jobs": jobs,
+        "marks": marks,
+        "history": {
+            "partial": len(candidates) < expected,
+            "detailedStartMs": min((job["startMs"] for job in jobs), default=None),
+            "firstDetailedGeneration": detailed[0] if detailed else None,
+            "lastDetailedGeneration": detailed[-1] if detailed else None,
+        },
+        "nowMs": int(time.time() * 1000) if now_ms is None else now_ms,
+    }
